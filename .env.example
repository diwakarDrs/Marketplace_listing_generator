# Copy to .env and fill in real values. Never commit .env.
# Database (used by docker-compose to build DATABASE_URL for the backend container)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=listing_generator
# Used when running the backend outside docker
DATABASE_URL=postgresql://user:password@localhost:5432/listing_generator

# Auth
# REQUIRED: generate with `openssl rand -hex 32` (>=32 chars). The app rejects this placeholder.
SECRET_KEY=<<GENERATE-WITH-openssl-rand-hex-32>>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
# Optional: exact callback URL registered with Google (defaults to the request-derived URL)
GOOGLE_REDIRECT_URI=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-api-host.example/auth/google/callback

# AI
OPENAI_API_KEY=your-openai-key
AI_MODEL=gpt-4o-mini
FREE_MONTHLY_GENERATIONS=20

# Frontend
VITE_API_URL=http://localhost:8000

# Proxy IPs uvicorn trusts for X-Forwarded-* headers (empty = none)
FORWARDED_ALLOW_IPS=

# Where the backend redirects after Google OAuth
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
